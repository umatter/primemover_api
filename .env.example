APP_NAME="Laravel Vue Spa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=primemover
DB_USERNAME=primemover
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

JWT_TTL=1440
JWT_SECRET=

# Add items needed for S3-based filesystem to work
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=arn:aws:s3:::primemover-gui-test
AWS_ACCESS_KEY_ID=REMOVED-aws-access-key
AWS_SECRET_ACCESS_KEY=REMOVED-aws-secret-key
AWS_USE_PATH_STYLE_ENDPOINT=false
# Where the GUI is served; the password-reset email links here (route password/reset/:token)
URL_FRONTEND=http://localhost:4200
AWS_MOCK=false

NOTIFICATION_TO_EMAIL=example@noreply.net

# Swagger/OpenAPI Documentation
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_OPEN_API_SPEC_VERSION=3.0.0
L5_SWAGGER_CONST_HOST=http://localhost:8080

# IPStack API (for IP geolocation on /api/v1/ip endpoint)
# Get a free API key from https://ipstack.com
IPSTACK_API_KEY=
IPSTACK_DEFAULT_LANGUAGE=en

# MCP Server Configuration (for AI assistant integration)
# Used by the Model Context Protocol server to access the API
PM_API_EMAIL=admin@primemover.example
PM_API_PASSWORD=password
PM_API_BASE_URL=http://localhost:8090/api/v1

# Throttle middleware whitelist (comma-separated IPs)
THROTTLE_WHITELIST=127.0.0.1,localhost

# ex63 edge overlay (docker-compose.ex63.yml, opt-in): the GUI and this API are
# served same-origin at https://primemover.${DOMAIN}. Unused by the base compose.
DOMAIN=qamelab.org
