APP_NAME="Laravel Vue Spa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost

# The zone a queue's `start_at` is interpreted in, and the one every client has
# to send its wall clock in.
#
# Pinned rather than left to the config default (Europe/Berlin), because the
# whole ecosystem's scheduling rests on it and nothing had actually chosen it:
# the runner, the e2e, the spec DSL and the canary all say "Europe/Zurich", and
# they agreed with the deployed API only because Berlin and Zurich share offsets
# year-round. That is a coincidence, not a configuration.
#
# It matters more than it looks. `start_at` is stored as WALL CLOCK -- the API
# keeps the digits and discards the offset it was sent -- so changing this zone
# reinterprets every scheduled queue, and a client in a different zone schedules
# at the wrong time with no error at all.
APP_TIMEZONE=Europe/Zurich

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=primemover
DB_USERNAME=primemover
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

JWT_TTL=1440
JWT_SECRET=

# Add items needed for S3-based filesystem to work
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_USE_PATH_STYLE_ENDPOINT=false

# The runner's job-data store (disk `s3runner`): every HAR, page source and
# lambda payload the runner captures. Despite the AWS_ naming this is a LOCAL
# MinIO, not AWS, so it needs an explicit endpoint -- without one the S3 client
# talks to real AWS and every read fails however the credentials are set.
#
# Each key falls back to the plain one above, so leaving these blank keeps an
# existing deployment working unchanged. Set them to give this disk a scoped,
# READ-ONLY credential of its own, which is what it should have: it only reads.
#
# AWS_BUCKET_RUNNER is the exception -- it has no fallback and is required, or
# the disk cannot be constructed at all.
#
# On ex63 the endpoint must be the internal address (http://minio:9000), not the
# public hostname: s3.qamelab.org answers 403 from a docker bridge address.
AWS_ENDPOINT_RUNNER=
AWS_BUCKET_RUNNER=
AWS_ACCESS_KEY_ID_RUNNER=
AWS_SECRET_ACCESS_KEY_RUNNER=
# MinIO serves buckets as a path segment, not a subdomain, so this is true for
# MinIO. It is separate from the shared flag above so that switching it on here
# does not switch it on for the unrelated `s3` disk.
AWS_USE_PATH_STYLE_ENDPOINT_RUNNER=true

# Where the GUI is served; the password-reset email links here (route password/reset/:token)
URL_FRONTEND=http://localhost:4200
# Despite the name this is not a test double: it selects WHERE the API's own
# file storage lives. false = the `s3` disk (real object storage); true = the
# LOCAL disk.
#
# On a deployment with no AWS account -- which includes ex63 -- true is the
# correct production value. With false the `s3` disk addresses AWS, and
# GET /experiments/{id}/download 500s: that endpoint writes the export zip to
# this disk and reads it straight back, so it fails wherever the disk cannot be
# written.
#
# It does NOT affect the runner's job data. That is the separate `s3runner`
# disk, which points at the local MinIO and is read by GET /file/{report}.
AWS_MOCK=true

NOTIFICATION_TO_EMAIL=example@noreply.net

# Swagger/OpenAPI Documentation
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_OPEN_API_SPEC_VERSION=3.0.0
L5_SWAGGER_CONST_HOST=http://localhost:8080

# IPStack API (for IP geolocation on /api/v1/ip endpoint)
# Get a free API key from https://ipstack.com
IPSTACK_API_KEY=
IPSTACK_DEFAULT_LANGUAGE=en

# MCP Server Configuration (for AI assistant integration)
# Used by the Model Context Protocol server to access the API
PM_API_EMAIL=admin@primemover.example
PM_API_PASSWORD=password
PM_API_BASE_URL=http://localhost:8090/api/v1

# Throttle middleware whitelist (comma-separated IPs)
THROTTLE_WHITELIST=127.0.0.1,localhost

# ex63 edge overlay (docker-compose.ex63.yml, opt-in): the GUI and this API are
# served same-origin at https://primemover.${DOMAIN}. Unused by the base compose.
DOMAIN=qamelab.org

# Per-user isolation / runner partitioning
PM_SERVICE_ACCOUNT_IDS=1
# Runner that executes experiments with runner_user_id = NULL (default 1).
PM_DEFAULT_RUNNER_USER_ID=1

# Runner work feed (GET /crawlers-unprocessed): only due work, budgeted per poll.
# See the 'runner' block in config/primemover.php. The lookahead must cover the
# largest runner.UpdateInterval (floor 15); stale-after must exceed the runner's
# MaxRedoMinutes of 45 (floor 46). Unset or 0 means the default shown.
PM_RUNNER_LOOKAHEAD_MINUTES=30
PM_RUNNER_STALE_AFTER_MINUTES=60
PM_RUNNER_MAX_QUEUES_PER_POLL=300
PM_RUNNER_MAX_JOBS_PER_POLL=10000
