{
  "name": "cretueusebiu/laravel-vue-spa",
  "description": "A Laravel-Vue SPA starter project template.",
  "keywords": [
    "spa",
    "laravel",
    "vue"
  ],
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.1",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-zip": "*",
    "darkaonline/l5-swagger": "^8.6",
    "guzzlehttp/guzzle": "^7.2",
    "hammerstone/fast-paginate": "^0.1.12",
    "laravel/framework": "^10.0",
    "laravel/helpers": "^v1.6.0",
    "laravel/legacy-factories": "^1.3",
    "laravel/passport": "^v11.8.3",
    "laravel/sanctum": "^3.2",
    "laravel/socialite": "^5.6.1",
    "laravel/tinker": "^2.8",
    "laravel/ui": "^4.2.1",
    "league/flysystem-aws-s3-v3": "^3.12",
    "maatwebsite/excel": "^3.1",
    "michael-rubel/laravel-enhanced-pipeline": "^3.2",
    "nelkasovic/ipstack-finder": "^1.0",
    "netresearch/jsonmapper": "^v4.4",
    "phpoffice/phpspreadsheet": "^1.29",
    "predis/predis": "^2.1.2",
    "psr/http-factory-implementation": "^1.0.1",
    "spatie/laravel-data": "^4.5",
    "spatie/laravel-query-builder": "^5.1",
    "symfony/http-client": "^6.2.7",
    "symfony/mailgun-mailer": "^6.2.7",
    "symfony/postmark-mailer": "^6.2.7",
    "toin0u/geocoder-laravel": "^4.6.0",
    "torann/geoip": "^3.0.5",
    "tymon/jwt-auth": "^2.0.0"
  },
  "require-dev": {
    "beyondcode/laravel-dump-server": "^1.9.0",
    "doctrine/dbal": "^3.0",
    "fakerphp/faker": "^1.9.1",
    "friendsofphp/php-cs-fixer": "3.14.4",
    "laravel/pint": "^1.7",
    "laravel/sail": "^1.18",
    "laravel/telescope": "^5.11",
    "mockery/mockery": "^1.4.4",
    "nunomaduro/collision": "^7.0",
    "nunomaduro/phpinsights": "^2.7",
    "phpunit/phpunit": "^10.0",
    "spatie/laravel-ignition": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeds/"
    },
    "classmap": [
      "database/seeds",
      "database/factories"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php artisan jwt:secret --force --ansi"
    ],
    "post-update-cmd": [
      "@php artisan cache:clear"
    ],
    "post-install-cmd": [
      "@php artisan cache:clear"
    ],
    "format": [
      "./vendor/bin/pint app",
      "./vendor/bin/pint database",
      "./vendor/bin/pint config",
      "./vendor/bin/pint routes",
      "./vendor/bin/pint tests"
    ],
    "lint": [
      "./vendor/bin/pint --test app",
      "./vendor/bin/pint --test database",
      "./vendor/bin/pint --test config",
      "./vendor/bin/pint --test routes",
      "./vendor/bin/pint --test tests"
    ],
    "lint-changed": [
      "./vendor/bin/pint --test --diff=origin/master"
    ]
  },
  "scripts-descriptions": {
    "format": "Rewrite app/database/config/routes/tests with Laravel Pint. Local use only -- it edits files.",
    "lint": "Check the whole tree against Pint without writing anything. Reports the pre-existing style debt too.",
    "lint-changed": "Check only what this branch changed since origin/master. This is what CI runs."
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/dusk",
        "nelkasovic/ipstack-finder"
      ]
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
