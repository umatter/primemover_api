APP_NAME="Primemover"
APP_ENV=local
APP_KEY=base64:uZDxdpvtmXDtRx137ChtwAWmxO8s0rFSuYzwLyYrt4I=
APP_DEBUG=true
APP_URL=http://localhost:8000
DEBUGBAR_ENABLED=false
LOG_CHANNEL=stack
APP_TIMEZONE="Europe/Zurich"
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
QUEUE_DRIVER=redis
SESSION_DRIVER=redis
TELESCOPE_ENABLED=true
SERVER_NAME=localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=:memory:
DB_USERNAME=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=laravel
REDIS_PORT=8889

MAIL_FROM_ADDRESS_EVENT=noreply@primemover
MAIL_FROM_ADDRESS_MODULE=noreply@primemover
MAIL_FROM_ADDRESS_REGISTER=noreply@primemover
MAIL_FROM_ADDRESS_GENERAL=noreply@primemover

mail_from_address=noreply@primemover.ch
MAIL_FROM_NAME="${APP_NAME}"
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=CHANGEME
MAIL_PASSWORD=CHANGEME
MAIL_ENCRYPTION=tls

# To determine the name of your containers
COMPOSE_PROJECT_NAME=primemover

# Configure the same value in the xdebug helper
XDEBUG_COOKIE_VALUE=PHPSTORM

# Possible values: php54, php56, php71, php72, php73, php74, php80, php81
PHPVERSION=php81
DOCUMENT_ROOT=./
VHOSTS_DIR=./docker/httpd/vhosts
APACHE_LOG_DIR=./docker/httpd/logs
PHP_INI=./docker/php/php.ini

# Possible values: mariadb, mysql, mysql8
DATABASE=mysql
MYSQL_DATA_DIR=./docker/mysql/data
MYSQL_LOG_DIR=./docker/mysql/logs

# If you already have the port 80 in use, you can change it (for example if you have Apache)
HOST_MACHINE_UNSECURE_HOST_PORT=81
HOST_MACHINE_SECURE_HOST_PORT=444

# If you already have the port 3306 in use, you can change it (for example if you have MySQL)
HOST_MACHINE_MYSQL_PORT=3306
HOST_MACHINE_MYSQL_PORT_TEST=3360
# If you already have the port 9090 in use, you can change it
HOST_MACHINE_PMA_PORT=9090

# If you already has the port 6379 in use, you can change it (for example if you have Redis)
HOST_MACHINE_REDIS_PORT=8889

PASSPORT_CLIENT_ID=3
PASSPORT_CLIENT_SECRET=test-passport-client-secret-000000000000
IPSTACK_API_KEY=00000000000000000000000000000000
# L5_SWAGGER_GENERATE_ALWAYS=true

# Add items needed for S3-based filesystem to work
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=arn:aws:s3:::primemover-gui-test
AWS_USE_PATH_STYLE_ENDPOINT=

