###############################################################################
# Docker Environment Configuration
#
# Copy this file to .env for Docker-based development:
#   cp .env.docker .env
#
# This file has Docker-ready defaults (container hostnames, correct ports).
# For non-Docker development, use .env.example instead.
###############################################################################

APP_NAME="PrimeMover API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost:8090

LOG_CHANNEL=stack

# Database - use container hostname
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=primemover
DB_USERNAME=primemover
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Redis - use container hostname
REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

JWT_TTL=1440
JWT_SECRET=

# AWS S3 Configuration
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=arn:aws:s3:::primemover-gui-test
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_USE_PATH_STYLE_ENDPOINT=false
URL_FRONTEND=https://pmswitchgui.primemover.example
AWS_MOCK=false

NOTIFICATION_TO_EMAIL=example@noreply.net

# Swagger/OpenAPI Documentation
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_OPEN_API_SPEC_VERSION=3.0.0
L5_SWAGGER_CONST_HOST=http://localhost:8090

# IPStack API (for IP geolocation on /api/v1/ip endpoint)
IPSTACK_API_KEY=
IPSTACK_DEFAULT_LANGUAGE=en

# MCP Server Configuration (for AI assistant integration)
PM_API_EMAIL=admin@primemover.example
PM_API_PASSWORD=password
PM_API_BASE_URL=http://localhost:8090/api/v1

###############################################################################
# Docker Compose Configuration
###############################################################################

# Container naming (ensures consistent names like primemover-mysql)
COMPOSE_PROJECT_NAME=primemover

# Document root for Apache/PHP containers
DOCUMENT_ROOT=.

# PHP configuration file
PHP_INI=./docker/php/php.ini
PHPVERSION=php8.1

# Port mappings (host:container)
HOST_MACHINE_UNSECURE_HOST_PORT=8090
HOST_MACHINE_SECURE_HOST_PORT=8443
HOST_MACHINE_MYSQL_PORT=3307
REDIS_PORT=8889

# Rate limiting whitelist (required by ConfigService)
THROTTLE_WHITELIST=127.0.0.1,localhost,172.0.0.0/8
