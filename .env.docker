# Docker Compose Environment Variables
COMPOSE_PROJECT_NAME=primemover
HOST_MACHINE_UNSECURE_HOST_PORT=8080
HOST_MACHINE_SECURE_HOST_PORT=8443
HOST_MACHINE_PMA_PORT=8081
HOST_MACHINE_MYSQL_PORT=3306
DOCUMENT_ROOT=.
PHPVERSION=php8.1
PHP_INI=./docker/php8.1-fpm/etc/php/php.ini
MYSQL_DATA_DIR=./storage/app/data/mysql
MYSQL_LOG_DIR=./storage/app/logs/mysql
XDEBUG_COOKIE_VALUE=PHPSTORM

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=primemover
DB_USERNAME=primemover
DB_PASSWORD=secret

# Redis Configuration
REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379

# Application Configuration
APP_NAME="Primemover API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Other Laravel settings
LOG_CHANNEL=stack
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

JWT_TTL=1440
JWT_SECRET=

# AWS S3 Configuration
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=arn:aws:s3:::primemover-gui-test
AWS_ACCESS_KEY_ID=REMOVED-aws-access-key
AWS_SECRET_ACCESS_KEY=REMOVED-aws-secret-key
AWS_USE_PATH_STYLE_ENDPOINT=false
URL_FRONTEND=https://pmswitchgui.primemover.example
AWS_MOCK=false

NOTIFICATION_TO_EMAIL=example@noreply.net

# Swagger/OpenAPI Documentation
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_OPEN_API_SPEC_VERSION=3.0.0
L5_SWAGGER_CONST_HOST=http://localhost:8080
